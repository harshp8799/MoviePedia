{
  "expo": {
    "name": "Movie Pedia",
    "slug": "movie-pedia",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "moviepedia",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "android": {
      "package": "com.moviepedia.app",
      "adaptiveIcon": {
        "backgroundColor": "#0b0d12"
      }
    },
    "ios": {
      "bundleIdentifier": "com.moviepedia.app",
      "supportsTablet": true
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "extra": {
      "apiBaseUrl": "http://localhost:8000/api/v1"
    }
  }
}
