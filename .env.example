# ============================================================================
# Movie Pedia — Environment template.  Copy to .env and fill in.  NEVER commit .env.
# ============================================================================

# ---- Environment selector -------------------------------------------------
APP_ENV=local                 # local | dev | staging | production

# ---- Firebase (client-safe config — web & mobile) -------------------------
# From Firebase console > Project settings > Your apps. Safe to expose to clients.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=movie-pedia-local
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Web app reads these (Next.js requires NEXT_PUBLIC_ prefix to expose to browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=movie-pedia-local
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Mobile (Expo requires EXPO_PUBLIC_ prefix)
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
EXPO_PUBLIC_FIREBASE_API_KEY=

# ---- Backend / FastAPI (server-only — NEVER expose to clients) ------------
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000,http://localhost:8081
# Path to Firebase service-account JSON. Keep OUTSIDE the repo. Empty => use emulator.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_ADMIN_PROJECT_ID=movie-pedia-local

# ---- Firebase Emulator Suite (local dev, free) ----------------------------
# When set, Admin SDK & clients talk to local emulators instead of prod.
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199
USE_FIREBASE_EMULATOR=true

# ---- Logging --------------------------------------------------------------
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json               # json | console
