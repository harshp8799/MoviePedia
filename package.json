{
  "name": "movie-pedia",
  "version": "0.1.0",
  "private": true,
  "description": "Movie Pedia — public movie & TV-series catalog (web + Android + FastAPI + Firebase).",
  "workspaces": [
    "apps/web",
    "apps/mobile",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace apps/web",
    "dev:mobile": "npm run start --workspace apps/mobile",
    "build:web": "npm run build --workspace apps/web",
    "lint": "eslint . --ext .js,.jsx --ignore-path .gitignore",
    "format": "prettier --write \"**/*.{js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,json,md}\"",
    "emulators": "firebase emulators:start --project movie-pedia-local",
    "seed": ".venv/bin/python scripts/seed.py",
    "claims": ".venv/bin/python scripts/set_admin_claims.py",
    "reset": ".venv/bin/python scripts/reset_dev_data.py",
    "test:rules": "firebase emulators:exec --only firestore,storage --project movie-pedia-local \"node --test 'firebase/tests/*.test.mjs'\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.30",
    "firebase": "^12.16.0",
    "firebase-tools": "^15.24.0",
    "prettier": "^3.4.1"
  },
  "engines": {
    "node": ">=20"
  }
}
