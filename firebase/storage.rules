rules_version = '2';

// ============================================================================
// Movie Pedia — Cloud Storage rules.
// Uploads happen via signed URLs issued by the backend AFTER validation
// (type/size) — see ADR-006. Direct client writes are denied everywhere.
// Public images (posters/backdrops) are world-readable; original videos and
// any non-public path are served only through backend-signed URLs.
// ============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    // Public, published imagery — read-only for everyone, never client-writable.
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Everything else (originals, drafts, processing artifacts): no client access.
    // Reads happen via short-TTL signed URLs minted by the backend.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
